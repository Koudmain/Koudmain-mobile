{
  "name": "@koudmain/ui",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./gluestack": "./src/components/ui/index.ts",
    "./screens": "./src/screens/index.ts",
    "./api": "./src/api/index.ts",
    "./*": [
      "./src/*.tsx",
      "./src/*.ts"
    ]
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "lint:check": "eslint \"src/**/*.{ts,tsx,js}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx,js}\" --fix",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js}\"",
    "format:fix": "prettier --write \"src/**/*.{ts,tsx,js}\"",
    "check-types": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@koudmain/eslint-config": "workspace:*",
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.1.0",
    "eslint": "^9.25.0",
    "prettier": "3.8.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-native": "*",
    "react-native-calendars": "*"
  },
  "dependencies": {
    "libphonenumber-js": "^1.13.6"
  }
}
