{
  "expo": {
    "name": "Koudmain",
    "slug": "Koudmain",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "koudmain",
    "jsEngine": "hermes",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "config": {
        "googleMapsApiKey": "AIzaSyAcIFRYDlB-syKbxEZqIqseaJE4bQroVtI"
      },
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAcIFRYDlB-syKbxEZqIqseaJE4bQroVtI"
        }
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.Koudmain"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAllowPermissionDescription": "Permettre à Koudmain d'accéder à votre position pour vous proposer des missions à proximité.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "expo-font",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "tsconfigPaths": true
    }
  }
}
