{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".expo/**", "dist/**"]
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "expo-go": {
      "cache": false,
      "persistent": true
    },
    "lint:check": {
      "outputs": []
    },
    "lint:fix": {
      "cache": false,
      "outputs": []
    },
    "format:check": {
      "outputs": []
    },
    "format:fix": {
      "cache": false,
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
