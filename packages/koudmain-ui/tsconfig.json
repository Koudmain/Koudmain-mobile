{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@koudmain/ui/*": ["./src/*"],
      "@koudmain/ui": ["./src"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "process-env.d.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ]
}
