{
  "name": "koudmain-mobile",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "employer": "pnpm --filter employer-apps dev",
    "worker": "pnpm --filter worker-apps dev",
    "lint": "turbo lint",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/*/.expo"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.6",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "nativewind": "^4.2.3",
    "tailwindcss": "^3.4.17"
  },
  "pnpm": {
    "overrides": {
      "react": "19.1.0",
      "react-dom": "19.1.0"
    }
  }
}
