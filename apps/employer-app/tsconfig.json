{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": ["./src/*", "./*"],
      "@koudmain/ui/*": ["../../packages/koudmain-ui/src/*"],
      "tailwind.config": ["./tailwind.config.js"],
      "@koudmain/ui": ["../../packages/koudmain-ui/src"]
    },
    "jsx": "react-native"
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.d.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts",
    "../../packages/koudmain-ui/src/api/documenso.api.ts"
  ]
}
