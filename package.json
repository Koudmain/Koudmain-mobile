{
  "name": "koudmain-mobile",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.33.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run expo-go --parallel",
    "dev:worker": "turbo run expo-go --filter=@koudmain/worker",
    "dev:employer": "turbo run expo-go --filter=@koudmain/employer",
    "worker": "pnpm --filter=@koudmain/worker start",
    "employer": "pnpm --filter=@koudmain/employer start",
    "worker-go": "pnpm --filter=@koudmain/worker expo-go",
    "employer-go": "pnpm --filter=@koudmain/employer expo-go",
    "build": "turbo run build",
    "build:worker": "turbo run build --filter=@koudmain/worker",
    "build:employer": "turbo run build --filter=@koudmain/employer",
    "lint:check": "turbo run lint:check",
    "lint:fix": "turbo run lint:fix",
    "format:check": "turbo run format:check",
    "format:fix": "turbo run format:fix",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.5.4"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
