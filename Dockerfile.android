# syntax=docker/dockerfile:1.7
# Build image for Expo / React Native applications
# Based on the requirements of the "ubuntu-26.04-jdk-17-ndk-r27b-sdk-57" image
FROM ubuntu:26.04

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8

# ---------------------------------------------------------------------------
# Base system dependencies
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    wget \
    unzip \
    zip \
    git \
    ca-certificates \
    gnupg \
    build-essential \
    python3 \
    locales \
    openssh-client \
    xz-utils \
    && locale-gen en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# Java 17 (JDK)
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    openjdk-17-jdk \
    && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV PATH="${JAVA_HOME}/bin:${PATH}"

# ---------------------------------------------------------------------------
# Android SDK + NDK 27.1.12297006
# ---------------------------------------------------------------------------
ENV ANDROID_HOME=/opt/android-sdk
ENV ANDROID_SDK_ROOT=${ANDROID_HOME}
ENV NDK_VERSION=27.1.12297006
ENV ANDROID_NDK_HOME=${ANDROID_HOME}/ndk/${NDK_VERSION}
ENV PATH="${ANDROID_HOME}/cmdline-tools/latest/bin:${ANDROID_HOME}/platform-tools:${ANDROID_HOME}/emulator:${ANDROID_NDK_HOME}:${PATH}"

RUN mkdir -p ${ANDROID_HOME}/cmdline-tools \
    && cd ${ANDROID_HOME}/cmdline-tools \
    && curl -fsSL -o cmdline-tools.zip https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip \
    && unzip -q cmdline-tools.zip \
    && mv cmdline-tools latest \
    && rm cmdline-tools.zip

RUN yes | sdkmanager --sdk_root=${ANDROID_HOME} --licenses > /dev/null \
    && sdkmanager --sdk_root=${ANDROID_HOME} \
        "platform-tools" \
        "platforms;android-35" \
        "build-tools;35.0.0" \
        "ndk;${NDK_VERSION}" \
        "cmake;3.22.1"

# ---------------------------------------------------------------------------
# Node.js 22.23.1 + npm 10.9.8
# ---------------------------------------------------------------------------
ENV NODE_VERSION=22.23.1
ENV NVM_DIR=/opt/nvm

RUN mkdir -p ${NVM_DIR} \
    && curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.1/install.sh | bash \
    && . ${NVM_DIR}/nvm.sh \
    && nvm install ${NODE_VERSION} \
    && nvm alias default ${NODE_VERSION} \
    && nvm use default

ENV NODE_PATH="${NVM_DIR}/versions/node/v${NODE_VERSION}/lib/node_modules"
ENV PATH="${NVM_DIR}/versions/node/v${NODE_VERSION}/bin:${PATH}"

# Pin npm to the exact required version
RUN npm install -g npm@10.9.8

# ---------------------------------------------------------------------------
# Package managers: Yarn 1.22.22, pnpm 11.9.0, Bun 1.3.14
# ---------------------------------------------------------------------------
RUN npm install -g yarn@1.22.22 pnpm@11.9.0

RUN curl -fsSL https://bun.sh/install | BUN_INSTALL=/opt/bun bash -s "bun-v1.3.14"
ENV BUN_INSTALL=/opt/bun
ENV PATH="${BUN_INSTALL}/bin:${PATH}"

# ---------------------------------------------------------------------------
# node-gyp 13.0.0
# ---------------------------------------------------------------------------
RUN npm install -g node-gyp@13.0.0

# ---------------------------------------------------------------------------
# Maestro 2.6.1 (E2E testing)
# ---------------------------------------------------------------------------
ENV MAESTRO_VERSION=2.6.1
ENV MAESTRO_DIR=/opt/maestro

RUN curl -fsSL "https://get.maestro.mobile.dev" | bash -s -- --version ${MAESTRO_VERSION}
ENV PATH="${MAESTRO_DIR}/bin:${PATH}"

# ---------------------------------------------------------------------------
# Working directory + EAS CLI (optional but handy for Expo)
# ---------------------------------------------------------------------------
RUN npm install -g eas-cli expo-cli
